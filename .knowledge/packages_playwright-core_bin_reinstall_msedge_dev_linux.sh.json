{"is_source_file": true, "format": "bash/shell script", "description": "This script automates the installation of Microsoft Edge Dev browser on Linux systems, specifically supporting Ubuntu and Debian distributions. It checks for system architecture, verifies OS compatibility, removes existing Edge Dev installations, installs necessary tools (curl, gpg), adds Microsoft's GPG key and repository, updates package lists, and installs Edge Dev. Finally, it outputs the installed version.", "external_files": ["/etc/os-release"], "external_methods": ["dpkg --get-selections", "apt-get remove", "command -v curl", "apt-get update", "apt-get install", "command -v gpg", "curl", "gpg --dearmor"], "published": [], "classes": [], "methods": [], "calls": ["arch", "echo", "exit", "bash -c 'source /etc/os-release && echo $ID'", "dpkg --get-selections", "grep", "apt-get remove", "command -v curl", "apt-get update", "apt-get install", "curl", "gpg --dearmor", "install", "rm", "apt-get update", "apt-get install", "microsoft-edge-dev --version"], "search-terms": ["install", "Edge Dev", "Linux package", "GPG key", "Ubuntu", "Debian", "Microsoft Edge"], "state": 2, "file_id": 1669, "knowledge_revision": 6317, "git_revision": "224d7bf847b6287f8aa27407d7238671a94efd70", "hash": "73fc5ef967ad4d0ca5bdc07a1e5c866b", "format-version": 4, "code-base-name": "playwright-307385", "filename": "packages/playwright-core/bin/reinstall_msedge_dev_linux.sh", "revision_history": [{"6317": "224d7bf847b6287f8aa27407d7238671a94efd70"}]}